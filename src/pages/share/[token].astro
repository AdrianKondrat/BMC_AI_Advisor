---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import CanvasReadOnly from "@/components/CanvasReadOnly";
import { createAnonClient } from "@/lib/supabase";
import type { Canvas } from "@/types";

const TOKEN_REGEX = /^[0-9a-zA-Z_-]+$/;

const { token } = Astro.params;

let canvas: Canvas | null = null;
let invalid = false;

if (!token || !TOKEN_REGEX.test(token)) {
  invalid = true;
} else {
  const supabase = createAnonClient();
  if (!supabase) {
    invalid = true;
  } else {
    const { data: shareLink, error: shareError } = await supabase
      .from("share_links")
      .select("canvas_id, expires_at")
      .eq("token", token)
      .single();

    const isExpired = (expiresAt: string | null) => (expiresAt ? new Date(expiresAt) < new Date() : false);

    if (shareError || !shareLink || isExpired(shareLink.expires_at)) {
      invalid = true;
    } else {
      const { data: canvasData, error: canvasError } = await supabase
        .from("canvases")
        .select("*")
        .eq("id", shareLink.canvas_id)
        .single();

      if (canvasError || !canvasData) {
        invalid = true;
      } else {
        canvas = canvasData as Canvas;
      }
    }
  }
}
---

<Layout title={canvas ? `${canvas.name ?? "Canvas"} — Shared` : "Invalid share link"}>
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-6xl">
      {
        invalid || !canvas ? (
          <div class="flex min-h-[60vh] flex-col items-center justify-center gap-4 text-center">
            <h1 class="text-2xl font-semibold text-white">Link expired or invalid</h1>
            <p class="text-white/60">This share link has expired or is invalid.</p>
          </div>
        ) : (
          <CanvasReadOnly canvas={canvas} />
        )
      }
    </div>
  </div>
</Layout>
