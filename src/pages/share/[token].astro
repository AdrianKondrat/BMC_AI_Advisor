---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import CanvasReadOnly from "@/components/CanvasReadOnly";
import type { Canvas } from "@/types";

const { token } = Astro.params;

let canvas: Canvas | null = null;
let invalid = false;

if (!token) {
  invalid = true;
} else {
  try {
    const shareUrl = new URL(`/api/share/${token}`, Astro.request.url);
    const shareResponse = await fetch(shareUrl.toString(), {
      headers: {
        Cookie: "",
      },
      credentials: "omit",
    });

    if (!shareResponse.ok) {
      invalid = true;
    } else {
      const payload = (await shareResponse.json()) as { canvas?: Canvas };
      if (!payload.canvas) {
        invalid = true;
      } else {
        canvas = payload.canvas;
      }
    }
  } catch {
    invalid = true;
  }
}
---

<Layout title={canvas ? `${canvas.name ?? "Canvas"} — Shared` : "Invalid share link"}>
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-6xl">
      {
        invalid || !canvas ? (
          <div class="flex min-h-[60vh] flex-col items-center justify-center gap-4 text-center">
            <h1 class="text-2xl font-semibold text-white">Link expired or invalid</h1>
            <p class="text-white/60">This share link has expired or is invalid.</p>
          </div>
        ) : (
          <CanvasReadOnly canvas={canvas} />
        )
      }
    </div>
  </div>
</Layout>
