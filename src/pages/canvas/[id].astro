---
import Layout from "@/layouts/Layout.astro";
import CanvasEditor from "@/components/CanvasEditor";
import { createClient } from "@/lib/supabase";
import type { Canvas, ShareLink } from "@/types";

const { user } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let canvas: Canvas | null = null;
if (supabase && id) {
  const { data } = await supabase.from("canvases").select("*").eq("id", id).eq("owner_id", user.id).single();
  if (data) canvas = data as unknown as Canvas;
}

if (!canvas) return Astro.redirect("/dashboard");

let shareLink: ShareLink | null = null;
if (supabase && id) {
  const { data } = await supabase
    .from("share_links")
    .select("*")
    .eq("canvas_id", id)
    .order("created_at", { ascending: false })
    .limit(1)
    .maybeSingle();
  if (data) shareLink = data;
}
---

<Layout title={canvas.name ?? "Canvas"}>
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8">
        <a href="/dashboard" class="text-sm text-white/50 hover:text-white/80">← Back to dashboard</a>
      </header>
      <CanvasEditor client:load canvas={canvas} initialShareLink={shareLink} />
    </div>
  </div>
</Layout>
