---
import Layout from "@/layouts/Layout.astro";
import NewCanvasForm from "@/components/NewCanvasForm";
---

<Layout title="New Canvas">
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-2xl">
      <header class="mb-8">
        <a href="/dashboard" class="text-sm text-white/50 hover:text-white/80">← Back to dashboard</a>
      </header>
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Create a new canvas
      </h1>
      <p class="mb-8 text-white/60">Describe your business idea and AI will fill all 9 BMC blocks for you.</p>
      <NewCanvasForm client:load />
    </div>
  </div>
</Layout>
